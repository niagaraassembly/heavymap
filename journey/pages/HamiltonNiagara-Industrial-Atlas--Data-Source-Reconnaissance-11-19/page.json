     ],
     "tag": "code"
    },
    ", ",
    {
     "children": [
      "shop=trade"
     ],
     "tag": "code"
    },
    ", ",
    {
     "children": [
      "railway=*"
     ],
     "tag": "code"
    },
    ", ",
    {
     "children": [
      "harbour=*"
     ],
     "tag": "code"
    },
    ", ",
    {
     "children": [
      "waterway=*"
     ],
     "tag": "code"
    },
    ", ",
    {
     "children": [
      "power=substation|line"
     ],
     "tag": "code"
    },
    "."
   ],
   "tag": "p"
  },
  {
   "children": [
    {
     "children": [
      "ODbL is the strictest licence in this list."
     ],
     "tag": "strong"
    },
    " Any published derivative that mixes OSM geometry with other sources may trigger share-alike. Keep OSM-derived features tagged as such in the provenance block so the obligation is traceable rather than discovered later."
   ],
   "tag": "p"
  },
