    " 311 ",
    {
     "children": [
      "landuse=industrial"
     ],
     "tag": "code"
    },
    " ways within the Hamilton bounding box ",
    {
     "children": [
      "(43.15,-80.05,43.35,-79.68)"
     ],
     "tag": "code"
    },
    "."
   ],
   "tag": "p"
  },
  {
   "children": [
    "This is the only source that covers the whole study area — Hamilton, Halton, Niagara and across the border — with one consistent schema. It is the backbone for cross-boundary features (rail corridors, the Welland Canal, the harbour) that no single municipality publishes end to end."
   ],
   "tag": "p"
  },
  {
   "children": [
    "Relevant tags: ",
    {
     "children": [
      "landuse=industrial"
     ],
     "tag": "code"
    },
    ", ",
    {
     "children": [
      "building=industrial|warehouse|factory"
     ],
     "tag": "code"
    },
    ", ",
    {
     "children": [
      "man_made=works"
     ],
     "tag": "code"
    },
    ", ",
    {
     "children": [
      "industrial=*"
     ],
     "tag": "code"
    },
    ", ",
