       ],
       "tag": "code"
      },
      " · Atlas category: ",
      {
       "children": [
        "land"
       ],
       "tag": "code"
      }
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Zoning By-law Boundary"
       ],
       "tag": "strong"
      },
      " — Records: 11,931 · Endpoint suffix: ",
      {
       "children": [
        "Zoning_By_law_Boundary/FeatureServer/1"
       ],
       "tag": "code"
      },
      " · Atlas category: ",
      {
       "children": [
        "land"
       ],
       "tag": "code"
      },
      " / ",
      {
       "children": [
        "planning"
       ],
       "tag": "code"
      }
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Buildings"
       ],
       "tag": "strong"
      },
      " — Records: 214,293 · Endpoint suffix: ",
      {
       "children": [
        "Buildings/FeatureServer/8"
       ],
       "tag": "code"
      },
      " · Atlas category: ",
      {
       "children": [
        "building"
       ],
       "tag": "code"
      }
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Railways"
       ],
       "tag": "strong"
      },
      " — Records: 1,692 · Endpoint suffix: ",
      {
       "children": [
        "Railways/FeatureServer/10"
       ],
       "tag": "code"
      },
      " · Atlas category: ",
      {
       "children": [
        "rail"
       ],
       "tag": "code"
      }
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Truck Route Network"
       ],
       "tag": "strong"
      },
      " — Records: 1,250 · Endpoint suffix: ",
      {
       "children": [
        "Truck_Route_Network/FeatureServer/5"
       ],
       "tag": "code"
      },
      " · Atlas category: ",
      {
       "children": [
        "road"
       ],
       "tag": "code"
      }
     ],
     "tag": "li"
    }
   ],
   "tag": "ul"
  },
  {
   "children": [
    {
     "children": [
      "Also present and relevant, not yet field-inspected:"
     ],
     "tag": "strong"
    },
    " Addresses, Development Applications, Vacant Building Registry, Businesses by Employee Count, City/Urban/Rural Boundary, Waterbodies, Watercourse, Airport, Business Improvement Areas, Building and Demolition Permits (2008–2016 and 2017–present), Planning Applications Reported Quarterly, Historic Railways."
   ],
   "tag": "p"
  },
  {
   "children": [
    {
     "children": [
      "Note on Employment Lands:"
     ],
     "tag": "strong"
    },
    " 22 features is a small number because these are large designated ",
    {
     "children": [
      "areas"
     ],
     "tag": "em"
    },
    ", not sites. This is the authoritative answer to \"where is industrial land in Hamilton\" and should be a foundational polygon layer, not a point layer."
   ],
   "tag": "p"
  },
  {
   "children": [
    {
     "children": [
      "Caution:"
     ],
     "tag": "strong"
    },
    " the numeric layer index in each FeatureServer URL (",
    {
     "children": [
      "/2"
     ],
     "tag": "code"
    },
    ", ",
    {
     "children": [
      "/8"
     ],
     "tag": "code"
    },
    ", ",
    {
     "children": [
      "/10"
     ],
     "tag": "code"
    },
    ") is assigned by the publisher and has been observed to change. Resolve layers by name through the DCAT feed at build time rather than hard-coding indices."
   ],
   "tag": "p"
  },
  {
   "tag": "hr"
  },
  {
   "attrs": {
    "id": "2.-Niagara-Region-—-Consolidated-NEI-(Niagara-Employment-Inventory)"
   },
   "children": [
    "2. Niagara Region — Consolidated NEI (Niagara Employment Inventory)"
   ],
   "tag": "h4"
  },
  {
   "children": [
    {
     "children": [
      {
       "children": [
        "Organization"
       ],
       "tag": "strong"
      },
      " — : Niagara Region"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Catalogue record"
       ],
       "tag": "strong"
      },
      " — : https://niagaraopendata.ca/dataset/consolidated-nei-opendata"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Data portal"
       ],
       "tag": "strong"
      },
      " — : https://open.niagararegion.ca/datasets/NiagaraRegion::consolidated-nei-opendata"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Service"
       ],
       "tag": "strong"
      },
      " — : ",
      {
       "children": [
        "https://services1.arcgis.com/WxiLK82TWf8W3O3f/arcgis/rest/services/OpenData_Consolidated_NEI_Opendata/FeatureServer/45"
       ],
       "tag": "code"
      }
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "GeoJSON download"
       ],
       "tag": "strong"
      },
      " — : ",
      {
       "children": [
        "https://open.niagararegion.ca/api/download/v1/items/d23f4f781add4584904bc78b94c869b3/geojson?layers=45"
       ],
       "tag": "code"
      }
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Format"
       ],
       "tag": "strong"
      },
      " — : GeoJSON, CSV, Shapefile, KML, ArcGIS REST"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Licence"
       ],
       "tag": "strong"
      },
      " — : ",
      {
       "children": [
        "Open Government Licence 2.0 (Niagara Region)"
       ],
       "tag": "strong"
      }
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Geometry"
       ],
       "tag": "strong"
      },
      " — : Point"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Records"
       ],
       "tag": "strong"
      },
      " — : ",
      {
       "children": [
        "98,065"
       ],
       "tag": "strong"
      },
      " (verified)"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Coverage"
       ],
       "tag": "strong"
      },
      " — : Niagara Region — all twelve municipalities"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Temporal"
       ],
       "tag": "strong"
      },
      " — : Consolidated inventory ",
      {
       "children": [
        "since 2016"
       ],
       "tag": "strong"
      },
      "; collection paused 2020–2021 (COVID)"
     ],
     "tag": "li"
    }
   ],
   "tag": "ul"
  },
  {
   "children": [
    {
     "children": [
      "Verified fields:"
     ],
     "tag": "strong"
    }
   ],
   "tag": "p"
  },
  {
   "children": [
    "nei_id, Year, municipality, businessname,\nbusinessstreetnumber, businessstreetname, businessunit,\nbusinesspobox, businesspostalcode, businesswebsite,\nprimarynaics, secondarynaics, primarysector, industry,\nyearopen, indoorgfa, sizerangeemployees"
   ],
   "tag": "pre"
  },
  {
   "children": [
    "This is the single richest source found. ",
    {
     "children": [
      "primarynaics"
     ],
     "tag": "code"
    },
    " + ",
    {
     "children": [
      "industry"
     ],
     "tag": "code"
    },
    " + ",
    {
     "children": [
      "sizerangeemployees"
     ],
     "tag": "code"
    },
    " + ",
    {
     "children": [
      "indoorgfa"
     ],
     "tag": "code"
    },
    " together support classification, weighting for the density layer, and floor-area analysis."
   ],
   "tag": "p"
  },
  {
   "children": [
    {
     "children": [
      "Critical handling requirement."
     ],
     "tag": "strong"
    },
    " This is a ",
    {
     "children": [
      "multi-year consolidated"
     ],
     "tag": "em"
    },
    " inventory, so the same business appears once per survey year. It is a record of what was observed in a given year, not a register of what is trading today. Per data quality rule 2, the ingestion must:"
   ],
   "tag": "p"
  },
  {
   "children": [
    {
     "children": [
      "Group by ",
      {
       "children": [
        "nei_id"
       ],
       "tag": "code"
      },
      " and keep the most recent ",
      {
       "children": [
        "Year"
       ],
       "tag": "code"
      },
      " per entity."
     ],
     "tag": "li"
    },
    {
     "children": [
      "Carry that ",
      {
       "children": [
        "Year"
       ],
       "tag": "code"
      },
      " through to the feature as its freshness stamp."
     ],
     "tag": "li"
    },
    {
     "children": [
      "Never render a 2016-only record as a currently operating business."
     ],
     "tag": "li"
    },
    {
     "children": [
      "Surface the observation year in the UI."
     ],
     "tag": "li"
    }
   ],
   "tag": "ol"
  },
  {
   "children": [
    "Note also there are two distinct Niagara portals: ",
    {
     "children": [
      "niagaraopendata.ca"
     ],
     "tag": "code"
    },
    " is a ",
    {
     "children": [
      "CKAN"
     ],
     "tag": "strong"
    },
    " catalogue (use ",
    {
     "children": [
      "/api/3/action/package_search"
     ],
     "tag": "code"
    },
    "), while the data itself is hosted on ",
    {
     "children": [
      "open.niagararegion.ca"
     ],
     "tag": "code"
    },
    ", an ",
    {
     "children": [
      "ArcGIS Hub"
     ],
     "tag": "strong"
    },
    ". The Hub does ",
    {
     "children": [
      "not"
     ],
     "tag": "em"
    },
    " serve a DCAT feed at the usual path; query the CKAN catalogue to discover, and the Hub to download."
   ],
   "tag": "p"
  },
  {
   "tag": "hr"
  },
