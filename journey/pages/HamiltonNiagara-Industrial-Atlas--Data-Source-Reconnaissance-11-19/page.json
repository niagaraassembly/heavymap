   },
   "children": [
    "Tier 1 — verified, high value, use in the first milestone"
   ],
   "tag": "h3"
  },
  {
   "attrs": {
    "id": "1.-City-of-Hamilton-Open-Data-(ArcGIS-Hub)"
   },
   "children": [
    "1. City of Hamilton Open Data (ArcGIS Hub)"
   ],
   "tag": "h4"
  },
  {
   "children": [
    {
     "children": [
      {
       "children": [
        "Organization"
       ],
       "tag": "strong"
      },
      " — : City of Hamilton"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Portal"
       ],
       "tag": "strong"
      },
      " — : https://open.hamilton.ca"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Catalogue feed"
       ],
       "tag": "strong"
      },
      " — : https://open.hamilton.ca/api/feed/dcat-us/1.1.json"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Service root"
       ],
       "tag": "strong"
      },
      " — : ",
      {
       "children": [
        "https://services.arcgis.com/rYz782eMbySr2srL/arcgis/rest/services"
       ],
       "tag": "code"
      }
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Format"
       ],
       "tag": "strong"
      },
      " — : ArcGIS FeatureServer → GeoJSON (",
      {
       "children": [
        "?f=geojson"
       ],
       "tag": "code"
