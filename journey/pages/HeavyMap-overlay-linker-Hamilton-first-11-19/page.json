    {
     "children": [
      {
       "children": [
        "Default input paths:"
       ],
       "tag": "strong"
      },
      " each ",
      {
       "children": [
        "default_rel"
       ],
       "tag": "code"
      },
      " names the real deb pull (",
      {
       "children": [
        "<source>/<dataset>-hamilton-2026-10-17/<dataset>-26917.geojson"
       ],
       "tag": "code"
      },
      "), so ",
      {
       "children": [
        "--data-root local-data"
       ],
       "tag": "code"
      },
      " finds all 11 layers."
     ],
     "tag": "li"
    }
   ],
   "tag": "ul"
  },
  {
   "children": [
    "Conservation Halton has no open regulation layer. It is a named gap, not a config row."
   ],
   "tag": "p"
