    {
     "children": [
      "four retired plans are filtered: ",
      {
       "children": [
        "Retired - Greensville"
       ],
       "tag": "code"
      },
      ", ",
      {
       "children": [
        "Retired - Downtown Hamilton"
       ],
       "tag": "code"
      },
      ", ",
      {
       "children": [
        "Retired - Clappisons Corner"
       ],
       "tag": "code"
