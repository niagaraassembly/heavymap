       ],
       "tag": "strong"
      },
      " — Example: ",
      {
       "children": [
        "15-pilot-join-matrix-welland-rochester.csv"
       ],
       "tag": "code"
      },
      " · Notes: A baseline, not truth."
     ],
     "tag": "li"
    }
   ],
   "tag": "ul"
  },
  {
   "attrs": {
    "id": "3.-Service-vs-layer-model"
   },
   "children": [
    "3. Service-vs-layer model"
   ],
   "tag": "h3"
  },
  {
   "children": [
    "Profile each publisher service once. Layers inherit service defaults and override only where they differ."
   ],
   "tag": "p"
  },
  {
   "children": [
    {
     "children": [
      {
       "children": [
        "Unit"
       ],
       "tag": "strong"
      },
      " — Service profile (",
      {
       "children": [
        "16-service-profile.csv"
       ],
       "tag": "code"
      },
      "): one ArcGIS server, portal or API · Layer profile (",
      {
       "children": [
        "17-layer-profile.csv"
       ],
       "tag": "code"
      },
      "): one layer or table"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Holds"
       ],
       "tag": "strong"
      },
      " — Service profile (",
      {
       "children": [
        "16-service-profile.csv"
       ],
       "tag": "code"
      },
      "): base URL, access method, auth, paging limit, default encoding and CRS, licence text, reliability · Layer profile (",
      {
       "children": [
        "17-layer-profile.csv"
       ],
       "tag": "code"
      },
      "): counts, id analysis, geometry, dates, nulls, owner field names, spine join, use decision"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Key"
       ],
       "tag": "strong"
      },
      " — Service profile (",
      {
       "children": [
        "16-service-profile.csv"
       ],
       "tag": "code"
      },
      "): ",
      {
       "children": [
        "service_id"
       ],
       "tag": "code"
      },
      " · Layer profile (",
      {
       "children": [
        "17-layer-profile.csv"
       ],
       "tag": "code"
      },
      "): ",
      {
       "children": [
        "layer_id"
       ],
       "tag": "code"
      },
      ", with ",
      {
       "children": [
        "service_id"
       ],
       "tag": "code"
      },
      " and ",
      {
       "children": [
        "inherits_from_service"
       ],
       "tag": "code"
      }
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Overrides"
       ],
       "tag": "strong"
      },
      " — Service profile (",
      {
       "children": [
        "16-service-profile.csv"
       ],
       "tag": "code"
      },
      "): n/a · Layer profile (",
      {
       "children": [
        "17-layer-profile.csv"
       ],
       "tag": "code"
      },
      "): a layer value wins; say why in ",
      {
       "children": [
        "notes"
       ],
       "tag": "code"
      }
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Quirks"
       ],
       "tag": "strong"
      },
      " — Service profile (",
      {
       "children": [
        "16-service-profile.csv"
       ],
       "tag": "code"
      },
      "): service-wide quirks go in ",
      {
       "children": [
        "notes"
       ],
       "tag": "code"
      },
      " · Layer profile (",
      {
       "children": [
        "17-layer-profile.csv"
       ],
       "tag": "code"
      },
      "): per-field quirks go in ",
      {
       "children": [
        "18-quirks-log.csv"
       ],
       "tag": "code"
      }
     ],
     "tag": "li"
    }
   ],
   "tag": "ul"
  },
  {
   "attrs": {
    "id": "3a.-Files"
   },
   "children": [
    "3a. Files"
   ],
   "tag": "h3"
  },
  {
   "children": [
    {
     "children": [
      {
       "children": [
        {
         "children": [
          "Spreadsheets/16-service-profile.csv"
         ],
         "tag": "code"
        }
       ],
       "tag": "strong"
      },
      " — Holds: One row per service"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        {
         "children": [
          "Spreadsheets/17-layer-profile.csv"
         ],
         "tag": "code"
        }
       ],
       "tag": "strong"
      },
      " — Holds: One row per layer"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        {
         "children": [
          "Spreadsheets/18-quirks-log.csv"
         ],
         "tag": "code"
        }
       ],
       "tag": "strong"
      },
      " — Holds: One row per quirk (",
      {
       "children": [
        "Q-NNN"
       ],
       "tag": "code"
      },
      ")"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        {
         "children": [
          "heavymap-planning/drafts/dataset-routine-SKILL.md"
         ],
         "tag": "code"
        }
       ],
       "tag": "strong"
      },
      " — Holds: Skill draft, not registered"
     ],
     "tag": "li"
    }
   ],
   "tag": "ul"
  },
  {
   "children": [
    "CSV format: UTF-8, no BOM, LF, RFC-4180 quoting, dates ",
    {
     "children": [
      "YYYY-MM-DD"
     ],
     "tag": "code"
    },
    ", no ",
    {
     "children": [
      ";"
     ],
     "tag": "code"
    },
    " inside a cell (use ",
    {
     "children": [
      " | "
     ],
     "tag": "code"
    },
    "), no owner values."
   ],
   "tag": "p"
  },
  {
   "attrs": {
    "id": "4.-Stages"
   },
   "children": [
    "4. Stages"
   ],
   "tag": "h3"
  },
  {
   "children": [
    "Linear comment rule: ",
    {
     "children": [
      "the agent doing a step posts its own comment on the slice issue at every step."
     ],
     "tag": "strong"
    },
    " an agent posts only roll-ups. Every comment uses the header ",
    {
     "children": [
      "Stage N / jurisdiction / family / layers touched / evidence URLs"
     ],
     "tag": "code"
    },
    ", then the stage line below."
   ],
   "tag": "p"
  },
  {
   "children": [
    {
     "children": [
      {
       "children": [
        "0"
       ],
       "tag": "strong"
      },
      " — Name: Slice plan · Output: Slice list: jurisdiction, family, 15-25 layers, lane per layer · Gate: the owner or Chief of Staff approves the slice · Comment template (after the header): ",
      {
       "children": [
        "Planned: <n> layers / <services> / lanes / order / out of scope"
       ],
       "tag": "code"
      }
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "1"
       ],
       "tag": "strong"
      },
      " — Name: Discover and catalog · Output: Service profile row; layer rows at ",
      {
       "children": [
        "catalogued"
       ],
       "tag": "code"
      },
      " · Gate: Every layer has an endpoint, a catalog row ref and a live check · Comment template (after the header): ",
      {
       "children": [
        "Found: <n> services, <n> layers. New vs catalog: <n>. Not reachable: <list>"
       ],
       "tag": "code"
      }
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "2"
       ],
       "tag": "strong"
      },
      " — Name: Pull · Output: Files in local data (not published); rows to ",
      {
       "children": [
        "pulled"
       ],
       "tag": "code"
      },
      " · Gate: Pulled count equals the server count, or the gap is explained · Comment template (after the header): ",
      {
       "children": [
        "Pulled: <layer> <n>/<n> records, method, paging, size. Failures: <list>"
       ],
       "tag": "code"
      }
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "3"
       ],
       "tag": "strong"
      },
      " — Name: Profile · Output: Layer profile filled; rows to ",
      {
       "children": [
        "profiled"
       ],
       "tag": "code"
      },
      " · Gate: All id, encoding, date, CRS, null and owner-name columns filled, with no owner values · Comment template (after the header): ",
      {
       "children": [
        "Profiled: <layer> id <field> <n> distinct / <n> null / <n> dup; encoding; CRS; owner fields (names only)"
       ],
       "tag": "code"
      }
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "4"
       ],
       "tag": "strong"
      },
      " — Name: Quirks log · Output: Rows in ",
      {
       "children": [
        "18-quirks-log.csv"
       ],
       "tag": "code"
      },
      "; layers with open quirks to ",
      {
       "children": [
        "formatting_needed"
       ],
       "tag": "code"
      },
      " · Gate: Each quirk has a type, count, example id and proposed handling · Comment template (after the header): ",
      {
       "children": [
        "Quirks: <n> new (<ids>). Blocking: <ids>. Example: <id>"
       ],
       "tag": "code"
      }
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "5"
       ],
       "tag": "strong"
      },
      " — Name: Harmonize · Output: Handling applied in a script or doc; rows to ",
      {
       "children": [
        "format_resolved"
       ],
       "tag": "code"
      },
      " · Gate: Each quirk is ",
      {
       "children": [
        "resolved"
       ],
       "tag": "code"
      },
      ", ",
      {
       "children": [
        "accepted"
       ],
       "tag": "code"
      },
      " or ",
      {
       "children": [
        "wontfix"
       ],
       "tag": "code"
      },
      ", with a re-run count · Comment template (after the header): ",
      {
       "children": [
        "Resolved: <ids>. Method: <how>. Before/after counts"
       ],
       "tag": "code"
      }
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "6"
       ],
       "tag": "strong"
      },
      " — Name: Verify · Output: Join test against the spine; method (exact, fuzzy, spatial) and grade (NA-86); rows to ",
      {
       "children": [
        "spined"
       ],
       "tag": "code"
      },
      " · Gate: ",
      {
       "children": [
        "hits/tested"
       ],
       "tag": "code"
      },
      " stated, with the sample or full population named; evidence write-up in the NA-79 style · Comment template (after the header): ",
      {
       "children": [
        "Spine join: <layer> -> <spine key> <method> <grade> <hits>/<tested>. Evidence: <url>"
       ],
       "tag": "code"
      }
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "7"
       ],
       "tag": "strong"
      },
      " — Name: Use decision · Output: Recommendation: use, ",
      {
       "children": [
        "not_used"
       ],
       "tag": "code"
      },
      " or defer; licence status noted · Gate: the owner records the decision · Comment template (after the header): ",
      {
       "children": [
        "Recommend: <use / not_used / defer>. Licence: <found / not found>. Risks: <list>"
       ],
       "tag": "code"
      }
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "8"
       ],
       "tag": "strong"
      },
      " — Name: Promote · Output: ",
      {
       "children": [
        "dormant"
       ],
       "tag": "code"
      },
      ", then ",
      {
       "children": [
        "surfaced"
       ],
       "tag": "code"
      },
      " · Gate: the owner's call. Public ",
      {
       "children": [
        "surfaced"
       ],
       "tag": "code"
      },
      " needs per-jurisdiction beta-gate sign-off (NA-269) · Comment template (after the header): ",
      {
       "children": [
        "Promoted: <layer> to <status> by the owner on <date>"
       ],
       "tag": "code"
      }
     ],
     "tag": "li"
    }
   ],
   "tag": "ul"
  },
  {
