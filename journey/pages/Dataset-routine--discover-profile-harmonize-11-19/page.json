       "tag": "strong"
      },
      " — Meaning: Data is in local data (not published). · Enters at: Stage 2 · Moved by: Agent"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        {
         "children": [
          "profiled"
         ],
         "tag": "code"
        }
       ],
       "tag": "strong"
      },
      " — Meaning: Profile columns filled. · Enters at: Stage 3 · Moved by: Agent"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        {
         "children": [
          "formatting_needed"
         ],
         "tag": "code"
        }
       ],
       "tag": "strong"
      },
      " — Meaning: Open quirks block use. · Enters at: Stage 4 · Moved by: Agent"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        {
         "children": [
          "format_resolved"
         ],
         "tag": "code"
        }
       ],
       "tag": "strong"
      },
      " — Meaning: Every blocking quirk is handled. · Enters at: Stage 5 · Moved by: Agent"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        {
         "children": [
          "spined"
         ],
         "tag": "code"
        }
       ],
       "tag": "strong"
      },
      " — Meaning: Joined to the spine, with ",
      {
       "children": [
        "spine_join_method"
       ],
       "tag": "code"
      },
      " (exact, fuzzy, spatial) and ",
      {
       "children": [
        "spine_join_grade"
       ],
       "tag": "code"
      },
      " (NA-86). · Enters at: Stage 6 · Moved by: Agent"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        {
         "children": [
          "dormant"
         ],
         "tag": "code"
        }
       ],
       "tag": "strong"
      },
      " — Meaning: In the live map, not shown to users. · Enters at: Stage 8 · Moved by: ",
      {
       "children": [
        "the owner"
       ],
       "tag": "strong"
      }
