   "attrs": {
    "id": "A.-Overlay-pulls"
   },
   "children": [
    "A. Overlay pulls"
   ],
   "tag": "h3"
  },
  {
   "children": [
    "For each layer: all fields (",
    {
     "children": [
      "outFields=*"
     ],
     "tag": "code"
    },
    "), an envelope query on the City extent, then intersection with ",
    {
     "children": [
      "City_Boundary/FeatureServer/13"
     ],
     "tag": "code"
    },
    "."
   ],
   "tag": "p"
  },
  {
   "children": [
    {
     "children": [
      {
       "children": [
        "Script:"
       ],
       "tag": "strong"
      },
      " local data (not published). It calls ",
      {
       "children": [
        "pull_arcgis_layer.py"
       ],
       "tag": "code"
      },
      ", then ",
      {
       "children": [
        "clip_to_hamilton.py"
       ],
       "tag": "code"
      },
      "."
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "Outputs per pull directory:"
       ],
       "tag": "strong"
      }
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "<dataset>.geojson"
       ],
       "tag": "code"
      },
      " (EPSG:4326, clipped)"
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "<dataset>-26917.geojson"
       ],
       "tag": "code"
      },
      " (EPSG:26917, clipped; the input for the overlay linker)"
