  {
   "attrs": {
    "id": "B.-First-PMTiles-build"
   },
   "children": [
    "B. First PMTiles build"
   ],
   "tag": "h3"
  },
  {
   "children": [
    {
     "children": [
      "Tools:"
     ],
     "tag": "strong"
    }
   ],
   "tag": "p"
  },
  {
   "children": [
    {
     "children": [
      "tippecanoe 2.53.0, from the Debian trixie package. There is no sudo on deb, so the package was extracted with ",
      {
       "children": [
        "apt-get download"
       ],
       "tag": "code"
      },
      " and ",
      {
       "children": [
        "dpkg -x"
       ],
       "tag": "code"
      },
      " into local data (not published) and symlinked into a local working copy. The deb's sha256 starts b929ec1c."
     ],
     "tag": "li"
    },
    {
     "children": [
      "go-pmtiles 1.31.2, from the GitHub release binary (tgz sha256 starts 3ed7dbf4)."
     ],
     "tag": "li"
    }
   ],
   "tag": "ul"
  },
  {
   "children": [
    {
     "children": [
      "Scripts"
     ],
     "tag": "strong"
    },
    " (committed in ",
    {
     "children": [
      "scripts/tiles/"
     ],
     "tag": "code"
    },
    "):"
   ],
   "tag": "p"
  },
  {
   "children": [
    {
     "children": [
      {
       "children": [
        "prep_tiles_hamilton.py <layer>"
       ],
       "tag": "code"
      },
      " writes EPSG:4326 line-delimited GeoJSON with public fields only."
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "build_tiles_hamilton.sh [layer]"
       ],
       "tag": "code"
      },
      " runs tippecanoe."
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "range_http_server.py"
       ],
       "tag": "code"
      },
      " is a local Range test server bound to 127.0.0.1. It is not deploy tooling."
     ],
     "tag": "li"
    }
   ],
   "tag": "ul"
  },
  {
   "children": [
    {
     "children": [
      "Output:"
     ],
     "tag": "strong"
    },
    " local data (not published)."
   ],
   "tag": "p"
  },
  {
   "children": [
    {
     "children": [
      "Fields per layer (public fields only):"
     ],
     "tag": "strong"
    }
   ],
   "tag": "p"
  },
  {
   "children": [
    {
     "children": [
      {
       "children": [
        "parcels:"
       ],
       "tag": "strong"
      },
      " heavymap_id (registry CURRENT run ",
      {
       "children": [
        "20261017T0725Z-run2"
       ],
       "tag": "code"
      },
      "), arn (first), arn_all (when more than one), arn_count, arn_grade, area_m2. Duplicate stacked geometries become one feature per HeavyMap ID. ",
      {
       "children": [
        "Owner"
       ],
       "tag": "code"
      },
      " and ",
      {
       "children": [
        "Legal_Txt"
       ],
       "tag": "code"
      },
      " exist only on NPCA Parcels_Cityview, which the prep never reads, and the prep asserts that no screened field name is present."
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "buildings:"
       ],
       "tag": "strong"
      },
      " heavymap_id, parcel_heavymap_id, name (City building name, when present), area_m2."
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "zoning:"
       ],
       "tag": "strong"
      },
      " all C002 attributes except Creator | Editor | GlobalID | Shape__Area | Shape__Length | CreationDate | EditDate. ",
      {
       "children": [
        "*_DATE"
       ],
       "tag": "code"
      },
      " fields become ISO dates."
     ],
     "tag": "li"
    },
    {
     "children": [
      {
       "children": [
        "nature-frame:"
       ],
       "tag": "strong"
      },
      " three layers:"
     ],
     "tag": "li"
    },
    {
     "children": [
      "greenbelt (",
      {
       "children": [
        "designation"
       ],
       "tag": "code"
      },
      ")"
     ],
     "tag": "li"
    },
    {
     "children": [
      "conservation (",
      {
       "children": [
        "authority"
       ],
       "tag": "code"
      },
      ": HCA | NPCA | GRCA, the regulation limits)"
     ],
     "tag": "li"
    },
    {
     "children": [
      "parks (",
      {
       "children": [
        "name"
       ],
       "tag": "code"
      },
      " | ",
      {
       "children": [
        "park_class"
       ],
       "tag": "code"
      },
      " | ",
      {
       "children": [
        "type"
       ],
       "tag": "code"
      },
      ")"
     ],
     "tag": "li"
    }
   ],
   "tag": "ul"
  },
  {
   "children": [
    {
     "children": [
      {
       "children": [
        "parcels.pmtiles"
       ],
       "tag": "strong"
      },
      " — Features in: 166,745 · Zooms: z12–15 · Size: 25.3 MB · Tiles: 2,217 · Build wall / peak RSS: 32 s / 257 MB"
