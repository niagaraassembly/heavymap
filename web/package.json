{
  "name": "heavymap-v0-local",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "fixture": "node scripts/make-fixture.mjs",
    "content:manifest": "node build/content-manifest.mjs",
    "content:snapshot": "node build/snapshot-issue-one.mjs --site ${NA_REPOS:-$HOME/github/niagaraassembly}/site --site-commit 9522b3e --make ${NA_REPOS:-$HOME/github/niagaraassembly}/make --make-commit d226deb && node build/content-manifest.mjs",
    "build:site": "node build/prerender.mjs",
    "build:site:preview": "node build/prerender.mjs --preview",
    "serve:site": "python3 -m http.server -d dist-site 4173 --bind 127.0.0.1",
    "build:site:launch": "node build/prerender.mjs --launch"
  },
  "dependencies": {
    "maplibre-gl": "6.14.0",
    "pmtiles": "4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "prettier": "3.6.2",
    "vite": "7.3.7"
  }
}
