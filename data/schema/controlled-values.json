  "score_formula": {
    "version": "1.0",
    "status": "proposal",
    "max_component": 3,
    "weights": {
      "c_joinability": 25,
      "c_coverage": 15,
      "c_grain": 10,
      "c_freshness": 10,
      "c_openness": 15,
      "c_quality": 10,
      "c_uniqueness": 10,
      "c_effort": 5
    },
    "blank_total_if_blank_weight_at_least": 15,
